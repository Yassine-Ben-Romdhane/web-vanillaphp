.home-page .frame {
  display: flex;
  width: 1440px;
  height: 50px;
  align-items: flex-start;
  justify-content: flex-end;
  gap: 10px;
  padding: 5px 30px;
  position: absolute;
  top: 3074px;
  left: calc(50.00% - 720px);
}

.home-page .frame-2 {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 50px;
  padding: 10px;
  position: relative;
  flex: 0 0 auto;
  margin-bottom: -2.00px;
}

.home-page .text-wrapper-3 {
  position: relative;
  width: fit-content;
  margin-top: -1.00px;
  font-family: "Montserrat-Medium", Helvetica;
  font-weight: 500;
  color: var(--variable-collection-BG-color);
  font-size: 18px;
  letter-spacing: 0;
  line-height: normal;
}

.home-page .navbar {
  display: flex;
  width: 1440px;
  align-items: center;
  justify-content: space-between;
  padding: 10px;
  position: absolute;
  top: 0;
  left: 0;
}

.home-page .logo {
  position: relative;
  width: 80px;
  height: 80px;
}

.home-page .logo img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.home-page .navbar-2 {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 50px;
  padding: 10px;
  position: relative;
  flex: 0 0 auto;
}
