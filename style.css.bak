.home-page {
  width: 100%;
  min-width: 1440px;
  min-height: 3124px;
  position: relative;
}

.home-page .plan-de-travail {
  position: absolute;
  top: 0;
  left: 0;
  width: 1440px;
  height: 795px;
  aspect-ratio: 1.81;
  object-fit: cover;
}

.home-page .arrow {
  position: absolute;
  top: 463px;
  left: 711px;
  width: 16px;
  height: 16px;
}

.home-page .img {
  width: 100%;
  left: -2.21%;
  height: 17px;
  position: absolute;
  top: 0;
  aspect-ratio: 1;
}

.home-page .arrow-2 {
  width: 75.00%;
  left: 10.29%;
  height: 13px;
  position: absolute;
  top: 0;
  aspect-ratio: 1;
}

.home-page .button {
  all: unset;
  box-sizing: border-box;
  position: absolute;
  top: 415px;
  left: 634px;
  width: 170px;
  height: 50px;
  border: 1px solid;
  border-color: var(--variable-collection-BG-color);
}

.home-page .text-wrapper {
  position: absolute;
  width: 50.59%;
  height: 36.00%;
  top: 28.00%;
  left: 25.29%;
  font-family: "Integral CF-DemiBold", Helvetica;
  font-weight: 700;
  color: #ffffff;
  font-size: 15px;
  letter-spacing: 2.25px;
  line-height: normal;
}

.home-page .element {
  position: absolute;
  top: 881px;
  left: 60px;
  width: 1342px;
  height: 367px;
  display: flex;
  gap: 57px;
}

.home-page .element-first-world-cup {
  margin-top: 49px;
  width: 733px;
  height: 228px;
  font-family: "Integral CF-Bold", Helvetica;
  font-weight: 400;
  color: #000000;
  font-size: 40px;
  letter-spacing: 0;
  line-height: normal;
}

.home-page .span {
  font-weight: var(--h1-font-weight);
  font-family: var(--h1-font-family);
  font-style: var(--h1-font-style);
  letter-spacing: var(--h1-letter-spacing);
  line-height: var(--h1-line-height);
  font-size: var(--h1-font-size);
}

.home-page .text-wrapper-2 {
  font-family: var(--paragraph-font-family);
  font-size: var(--paragraph-font-size);
  font-style: var(--paragraph-font-style);
  font-weight: var(--paragraph-font-weight);
  letter-spacing: var(--paragraph-letter-spacing);
  line-height: var(--paragraph-line-height);
}

